{
  "name": "schublade",
  "version": "0.1.0",
  "description": "Storybook-like component workshop served from a Rust CLI. No JS toolchain in your catalog repo.",
  "license": "MIT",
  "bin": {
    "schublade": "npm/bin/schublade.js"
  },
  "scripts": {
    "build:workshop": "node workshop/build.mjs",
    "test:workshop": "node workshop/groups.test.mjs",
    "test:npm": "node npm/test/platform.test.js && node npm/test/resolve.test.js && node npm/test/cargo.test.js && node npm/test/pack-platform.test.js && node npm/test/bin-integration.test.js && npm run test:workshop"
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@tabler/icons-react": "^3.35.0",
    "esbuild": "^0.25.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "files": [
    "npm/bin",
    "npm/lib",
    "README.md",
    "LICENSE"
  ],
  "optionalDependencies": {
    "@schublade/cli-darwin-arm64": "0.1.0",
    "@schublade/cli-darwin-x64": "0.1.0",
    "@schublade/cli-linux-arm64": "0.1.0",
    "@schublade/cli-linux-x64": "0.1.0",
    "@schublade/cli-win32-arm64": "0.1.0",
    "@schublade/cli-win32-x64": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schublade-org/schublade.git"
  },
  "homepage": "https://github.com/schublade-org/schublade#readme",
  "bugs": {
    "url": "https://github.com/schublade-org/schublade/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "schublade",
    "storybook",
    "workshop",
    "cli",
    "components"
  ]
}
